{
  "name": "novel-writing-assistant",
  "displayName": "写作助手",
  "description": "VS Code 扩展，用于小说写作帮助，包括打字统计、持续时间跟踪、字数统计、可配置的文本突出显示和文件类型过滤。",
  "version": "0.0.1",
  "publisher": "shayo",
  "repository": {
  "type": "git",
  "url": "https://github.com/shayo-yoo/novel-writing-assistant"
},
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:novelWritingAssistant.openConfig",
    "onCommand:novelWritingAssistant.highlightSelection",
    "onCommand:novelWritingAssistant.clearHighlights"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novelWritingAssistantContainer",
          "title": "Novel Writing Assistant",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "novelWritingAssistantContainer": [
        {
            "icon": "icon.png",
            "id": "novelWritingAssistantView",
             "name": "Dashboard"
        }
      ]
    },
    "commands": [
      {
        "command": "novelWritingAssistant.openConfig",
        "title": "Open Novel Writing Assistant Config"
      },
      {
        "command": "novelWritingAssistant.highlightSelection",
        "title": "Highlight Selected Text"
      },
      {
        "command": "novelWritingAssistant.clearHighlights",
        "title": "Clear All Highlight Rules"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "novelWritingAssistant.highlightSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
