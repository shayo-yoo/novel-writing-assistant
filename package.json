{
  "name": "novel-writing-assistant",
  "displayName": "写作助手",
  "description": "VS Code 扩展，用于小说写作帮助，包括打字统计、持续时间跟踪、字数统计、可配置的文本突出显示和文件类型过滤。",
  "icon": "images/icon.png",

  "version": "0.0.3",
  "publisher": "shayo",
  "repository": {
  "type": "git",
  "url": "https://github.com/shayo-yoo/novel-writing-assistant"
},
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:novelWritingAssistant.openConfig",
    "onCommand:novelWritingAssistant.openSettings",
    "onCommand:novelWritingAssistant.highlightSelection",
    "onCommand:novelWritingAssistant.clearHighlights"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "novelWritingAssistant.openConfig",
        "title": "打开写作助手配置 (Open config file)",
        "category": "小说写作助手"
      },
      {
        "command": "novelWritingAssistant.openSettings",
        "title": "打开写作助手设置 (Open extension settings)",
        "category": "小说写作助手"
      },
      {
        "command": "novelWritingAssistant.highlightSelection",
        "title": "高亮选中文本 (Highlight selected text)",
        "category": "小说写作助手"
      },
      {
        "command": "novelWritingAssistant.clearHighlights",
        "title": "清除高亮规则 (Clear highlight rules)",
        "category": "小说写作助手"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "novelWritingAssistant.highlightSelection",
          "when": "editorHasSelection && editorTextFocus",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "小说写作助手",
      "properties": {
        "novelWritingAssistant.enabledFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "md",
            "txt",
            "markdown",
            "json",
            "js",
            "ts",
            "py",
            "java",
            "c",
            "cpp",
            "cs",
            "html",
            "css",
            "xml"
          ],
          "description": "启用的文件格式。可以在 VS Code 设置 UI 中进行修改。"
        },
        "novelWritingAssistant.highlightItems": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            },
            "required": ["text", "color"]
          },
          "default": [],
          "description": "高亮规则列表。每个对象包含 text 和 color。"
        },
        "novelWritingAssistant.countMode": {
          "type": "string",
          "enum": [
            "words",
            "hanzi",
            "hanziWithoutPunctuation",
            "cjkCharacters",
            "nonWhitespaceCharacters",
            "characters",
            "nonAsciiCodePoints",
            "codePoints"
          ],
          "default": "words",
          "description": "字数统计方式。可选字词数、汉字、CJK字符、非空白字符、字符数、非ASCII码位和码位数。"
        },
        "novelWritingAssistant.typingIdleTimeoutMs": {
          "type": "number",
          "default": 5000,
          "minimum": 1000,
          "description": "输入速度统计在无新输入后暂停的倒计时时长（毫秒）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
